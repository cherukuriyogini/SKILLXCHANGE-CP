# =============================================================================
# SkillXchange Frontend — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# =============================================================================

# Backend API base URL (no trailing slash)
# Development:   http://localhost:5008/api
# Production:    https://your-backend-domain.com/api
VITE_API_URL=

# Backend WebSocket URL (no path, no trailing slash)
# Development:   http://localhost:5008
# Production:    https://your-backend-domain.com
VITE_SOCKET_URL=
