# =============================================================================
# SkillXchange — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env to version control.
# All keys listed here are required unless marked [OPTIONAL].
# =============================================================================

# --- Server ---
PORT=5008
NODE_ENV=production           # development | production

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# --- JWT Secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Keep stable — changing these invalidates all active sessions.
JWT_ACCESS_SECRET=<generate-64-byte-hex-random-secret>
JWT_REFRESH_SECRET=<generate-64-byte-hex-different-random-secret>
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# --- Legacy JWT (kept for backward compatibility) ---
JWT_SECRET=<generate-64-byte-hex-random-secret>
JWT_EXPIRE=7d

# --- Cookie ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=<generate-64-byte-hex-random-secret>

# --- Admin Access Control ---
# Must match the email address of the seeded/created admin user exactly.
ADMIN_EMAIL=admin@skillxchange.com

# --- Frontend ---
CLIENT_URL=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# --- Socket ---
SOCKET_PORT=5008

# --- AI — Gemini (primary AI provider) ---
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# --- AI — OpenAI [OPTIONAL] ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Cloudinary (file/image uploads) ---
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# --- Email (nodemailer / SMTP) ---
EMAIL_USER=<your-email@gmail.com>
EMAIL_PASS=<your-gmail-app-password>

# --- File Upload ---
MAX_FILE_SIZE=52428800   # 50 MB in bytes
